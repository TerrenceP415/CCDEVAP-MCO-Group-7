<div class="admin-page">
  

  <div class="tab-selector">
    <button class="tablinks" onclick="window.location.href='/admin/dashboard'">Analytics</button>
    <button class="tablinks tab-active" onclick="window.location.href='/admin/flights'">Flights</button>
    <button class="tablinks" onclick="window.location.href='/admin/users'">Users</button>
    <button class="tablinks" onclick="window.location.href='/admin/reservations'">Reservations</button>
  </div>

  <main class="tabcontent" id="admin-Flight">
    <h3><i class="bi bi-airplane"></i> Admin Flights</h3>
    <p>Manage all flight information and schedules.</p>

    <div class="admin-table-wrapper" id="flightsTableWrapper">
      <button
        id="addFlight"
        type="button"
        class="btn btn-primary action-btn-admin"
        data-bs-toggle="modal"
        data-bs-target="#addFlightModal"
      >
        Add New Flight
      </button>

      <table class="admin-table" id="flightsTable">
        <tr>
          <th>Flight Number</th>
          <th>Airline</th>
          <th>Origin</th>
          <th>Destination</th>
          <th>Departure Time</th>
          <th>Arrival Time</th>
          <th>Seats</th>
          <th>Price</th>
          <th>Actions</th>
        </tr>

        {{#each flights}}
        <tr data-id="{{this._id}}">
          <td>{{this.flightNumber}}</td>
          <td>{{this.airline}}</td>
          <td>{{this.origin}}</td>
          <td>{{this.destination}}</td>
          <td>{{this.departureDateTime}}</td>
          <td>{{this.arrivalDateTime}}</td>
          <td>{{this.availableSeats}} / {{this.totalSeats}}</td>
          <td>{{this.ticketPrice}}</td>
          <td>
            <button
              type="button"
              class="btn btn-primary action-btn-admin btn-edit"
              data-id="{{this._id}}"
              data-flight-number="{{this.flightNumber}}"
              data-airline="{{this.airline}}"
              data-origin="{{this.origin}}"
              data-destination="{{this.destination}}"
              data-departure="{{this.departureDateTime}}"
              data-arrival="{{this.arrivalDateTime}}"
              data-available-seats="{{this.availableSeats}}"
              data-total-seats="{{this.totalSeats}}"
              data-ticket-price="{{this.ticketPrice}}"
              data-bs-toggle="modal"
              data-bs-target="#editFlightModal"
            >
              Edit
            </button>

            <button
              type="button"
              class="btn btn-danger action-btn-admin btn-delete"
              data-id="{{this._id}}"
              data-bs-toggle="modal"
              data-bs-target="#deleteConfirmationModal"
            >
              Delete
            </button>
          </td>
        </tr>
        {{/each}}
      </table>
    </div>
  </main>

  <div class="modal fade" id="addFlightModal" tabindex="-1" role="dialog" aria-labelledby="addFlightModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addFlightModalTitle">Add Flight</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <form action="/admin/flights" method="POST">
            <div class="form-group">
              <label for="flightNumber">Flight Number</label>
              <input name="flightNumber" type="text" class="form-control" id="flightNumber" required>
            </div>
            <div class="form-group">
              <label for="airline">Airline</label>
              <input name="airline" type="text" class="form-control" id="airline" required>
            </div>
            <div class="form-group">
              <label for="origin">Origin</label>
              <input name="origin" type="text" class="form-control" id="origin" required>
            </div>
            <div class="form-group">
              <label for="destination">Destination</label>
              <input name="destination" type="text" class="form-control" id="destination" required>
            </div>
            <div class="form-group">
              <label for="departureDateTime">Departure Time</label>
              <input name="departureDateTime" type="datetime-local" class="form-control" id="departureDateTime" required>
            </div>
            <div class="form-group">
              <label for="arrivalDateTime">Arrival Time</label>
              <input name="arrivalDateTime" type="datetime-local" class="form-control" id="arrivalDateTime" required>
            </div>
            <div class="form-group">
              <label for="availableSeats">Available Seats</label>
              <input name="availableSeats" type="number" class="form-control" id="availableSeats" min="0" required>
            </div>
            <div class="form-group">
              <label for="totalSeats">Total Seats</label>
              <input name="totalSeats" type="number" class="form-control" id="totalSeats" min="0" required>
            </div>
            <div class="form-group">
              <label for="ticketPrice">Ticket Price</label>
              <input name="ticketPrice" type="number" class="form-control" id="ticketPrice" min="0" required>
            </div>

            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Discard</button>
              <button type="submit" class="btn btn-success">Add Flight</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editFlightModal" tabindex="-1" role="dialog" aria-labelledby="editFlightModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editFlightModalTitle">Edit Flight</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <form id="editFlightForm">
            <input type="hidden" id="editFlightId">

            <div class="form-group">
              <label for="editFlightNumber">Flight Number</label>
              <input name="flightNumber" type="text" class="form-control" id="editFlightNumber" required>
            </div>
            <div class="form-group">
              <label for="editAirline">Airline</label>
              <input name="airline" type="text" class="form-control" id="editAirline" required>
            </div>
            <div class="form-group">
              <label for="editOrigin">Origin</label>
              <input name="origin" type="text" class="form-control" id="editOrigin" required>
            </div>
            <div class="form-group">
              <label for="editDestination">Destination</label>
              <input name="destination" type="text" class="form-control" id="editDestination" required>
            </div>
            <div class="form-group">
              <label for="editDepartureDateTime">Departure Time</label>
              <input name="departureDateTime" type="datetime-local" class="form-control" id="editDepartureDateTime" required>
            </div>
            <div class="form-group">
              <label for="editArrivalDateTime">Arrival Time</label>
              <input name="arrivalDateTime" type="datetime-local" class="form-control" id="editArrivalDateTime" required>
            </div>
            <div class="form-group">
              <label for="editAvailableSeats">Available Seats</label>
              <input name="availableSeats" type="number" class="form-control" id="editAvailableSeats" min="0" required>
            </div>
            <div class="form-group">
              <label for="editTotalSeats">Total Seats</label>
              <input name="totalSeats" type="number" class="form-control" id="editTotalSeats" min="0" required>
            </div>
            <div class="form-group">
              <label for="editTicketPrice">Ticket Price</label>
              <input name="ticketPrice" type="number" class="form-control" id="editTicketPrice" min="0" required>
            </div>
          </form>
        </div>

        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Discard</button>
          
          <button type="button" id="saveFlightChanges" class="btn btn-success">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="deleteModalTitle">Delete Flight</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Are you sure you want to delete this flight?
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" id="confirmDeleteFlight" class="btn btn-danger">Delete Flight</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  let deleteFlightId = null;

  const formatDateTimeLocal = (value) => {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    const pad = (num) => String(num).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  };

  document.querySelectorAll('.btn-edit').forEach(button => {
    button.addEventListener('click', function () {
      document.getElementById('editFlightId').value = this.dataset.id;
      document.getElementById('editFlightNumber').value = this.dataset.flightNumber;
      document.getElementById('editAirline').value = this.dataset.airline;
      document.getElementById('editOrigin').value = this.dataset.origin;
      document.getElementById('editDestination').value = this.dataset.destination;
      document.getElementById('editDepartureDateTime').value = formatDateTimeLocal(this.dataset.departure);
      document.getElementById('editArrivalDateTime').value = formatDateTimeLocal(this.dataset.arrival);
      document.getElementById('editAvailableSeats').value = this.dataset.availableSeats;
      document.getElementById('editTotalSeats').value = this.dataset.totalSeats;
      document.getElementById('editTicketPrice').value = this.dataset.ticketPrice;
    });
  });

  const saveBtn = document.getElementById('saveFlightChanges');
  if (saveBtn) {
    saveBtn.addEventListener('click', function () {
      const flightId = document.getElementById('editFlightId').value;
      const flightData = {
        flightNumber: document.getElementById('editFlightNumber').value,
        airline: document.getElementById('editAirline').value,
        origin: document.getElementById('editOrigin').value,
        destination: document.getElementById('editDestination').value,
        departureDateTime: document.getElementById('editDepartureDateTime').value,
        arrivalDateTime: document.getElementById('editArrivalDateTime').value,
        availableSeats: document.getElementById('editAvailableSeats').value,
        totalSeats: document.getElementById('editTotalSeats').value,
        ticketPrice: document.getElementById('editTicketPrice').value
      };

      fetch(`/admin/flights/${flightId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(flightData)
      })
      .then(async response => {
        const data = await response.json().catch(() => ({}));
        if (response.ok && data.success) {
          window.location.reload();
        } else {
          throw new Error(data.message || 'Could not update flight');
        }
      })
      .catch(error => alert(error.message));
    });
  }

  document.querySelectorAll('.btn-delete').forEach(button => {
    button.addEventListener('click', function () {
      deleteFlightId = this.dataset.id;
    });
  });

  const deleteConfirmBtn = document.getElementById('confirmDeleteFlight');
  if (deleteConfirmBtn) {
    deleteConfirmBtn.addEventListener('click', function () {
      if (!deleteFlightId) return;

      fetch(`/admin/flights/${deleteFlightId}`, { method: 'DELETE' })
        .then(async response => {
          if (!response.ok) {
            const data = await response.json().catch(() => ({}));
            throw new Error(data.message || 'Could not delete flight');
          }

          const row = document.querySelector(`tr[data-id="${deleteFlightId}"]`);
          if (row) row.remove();
          deleteFlightId = null;

          const modalEl = document.getElementById('deleteConfirmationModal');
          if (modalEl && typeof $ === 'function') {
            $(modalEl).modal('hide');
          }
        })
        .catch(error => alert(error.message));
    });
  }
});
</script>