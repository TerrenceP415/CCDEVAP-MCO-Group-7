<!-- Search Form -->
<main class="search-shell">
    <section class="search-container">
        <form class="search-card" id="searchForm" novalidate>
            <p class="eyebrow">SkyEase</p>
            <h1><i class="bi bi-search"></i> Search Flights</h1>
            <p class="search-copy">Find your perfect flight.</p>

            <!-- Search Fields -->
            <div class="form-grid">
                <!-- Origin Airport -->
                <label for="origin"><i class="bi bi-airplane"></i> Origin Airport</label>
                <select name="origin" id="origin">
                    <option value="">Any Origin</option>
                    <option value="MNL">Manila - Ninoy Aquino International (MNL)</option>
                    <option value="LAX">Los Angeles International (LAX)</option>
                    <option value="SIN">Singapore Changi (SIN)</option>
                    <option value="NRT">Tokyo Narita (NRT)</option>
                    <option value="DXB">Dubai International (DXB)</option>
                    <option value="HKG">Hong Kong International (HKG)</option>
                    <option value="LHR">London Heathrow (LHR)</option>
                </select>

                <!-- Destination Airport -->
                <label for="destination"><i class="bi bi-airplane"></i> Destination Airport</label>
                <select name="destination" id="destination">
                    <option value="">Any Destination</option>
                    <option value="MNL">Manila - Ninoy Aquino International (MNL)</option>
                    <option value="LAX">Los Angeles International (LAX)</option>
                    <option value="SIN">Singapore Changi (SIN)</option>
                    <option value="NRT">Tokyo Narita (NRT)</option>
                    <option value="DXB">Dubai International (DXB)</option>
                    <option value="HKG">Hong Kong International (HKG)</option>
                    <option value="LHR">London Heathrow (LHR)</option>
                </select>

                <!-- Trip Type (One Way / Round Trip) -->
                <div class="trip-type-row">
                    <label><i class="bi bi-info-circle"></i> Trip Type</label>
                    <div class="select-container">
                        <input type="radio" id="one_way" name="trip_type" value="one_way">
                        <label for="one_way">One Way</label>
                        <input type="radio" id="round_trip" name="trip_type" value="round_trip" checked>
                        <label for="round_trip">Round Trip</label>
                    </div>
                </div>

                <!-- Departure Date -->
                <label for="departure_date"><i class="bi bi-calendar"></i> Departure Date</label>
                <input type="date" id="departure_date" name="departure_date">

                <!-- Return Date (disabled if one-way) -->
                <label for="return_date"><i class="bi bi-calendar"></i> Return Date</label>
                <input type="date" id="return_date" name="return_date">
                <span class="field-error" id="return-date-error" style="display:none; color:#e53e3e; font-size:12px; margin-top:-8px;">Return date must be after the departure date.</span>

                <!-- Passenger Count Steppers (Adults, Children, Infants) -->
                <label><i class="bi bi-people"></i> Passengers</label>
                <div class="passenger-breakdown">
                    <div class="pax-row">
                        <div class="pax-info">
                            <span class="pax-label">Adults</span>
                            <span class="pax-hint">12+ years</span>
                        </div>
                        <div class="pax-stepper">
                            <button type="button" class="pax-btn pax-minus" data-target="adults" aria-label="Decrease adults">&minus;</button>
                            <input type="number" id="adults" name="adults" value="1" min="1" max="9" readonly>
                            <button type="button" class="pax-btn pax-plus" data-target="adults" aria-label="Increase adults">+</button>
                        </div>
                    </div>
                    <div class="pax-row">
                        <div class="pax-info">
                            <span class="pax-label">Children</span>
                            <span class="pax-hint">2&ndash;11 years</span>
                        </div>
                        <div class="pax-stepper">
                            <button type="button" class="pax-btn pax-minus" data-target="children" aria-label="Decrease children">&minus;</button>
                            <input type="number" id="children" name="children" value="0" min="0" max="9" readonly>
                            <button type="button" class="pax-btn pax-plus" data-target="children" aria-label="Increase children">+</button>
                        </div>
                    </div>
                    <div class="pax-row">
                        <div class="pax-info">
                            <span class="pax-label">Infants</span>
                            <span class="pax-hint">Under 2 years</span>
                        </div>
                        <div class="pax-stepper">
                            <button type="button" class="pax-btn pax-minus" data-target="infants" aria-label="Decrease infants">&minus;</button>
                            <input type="number" id="infants" name="infants" value="0" min="0" max="4" readonly>
                            <button type="button" class="pax-btn pax-plus" data-target="infants" aria-label="Increase infants">+</button>
                        </div>
                    </div>
                </div>

                <!-- Cabin Class -->
                <label for="cabin_class"><i class="bi bi-building"></i> Cabin Class</label>
                <select name="cabin_class" id="cabin_class">
                    <option value="">Any Class</option>
                    <option value="economy">Economy</option>
                    <option value="premium_economy">Premium Economy</option>
                    <option value="business">Business</option>
                    <option value="first_class">First Class</option>
                </select>
            </div>

            <!-- Advanced Search Options (collapsible) -->
            <details class="accordion-container">
                <summary><i class="bi bi-gear"></i> Advanced search options</summary>
                <div class="accordion-panel">
                    <!-- Airline Filter -->
                    <label for="airline"><i class="bi bi-airplane"></i> Preferred Airline</label>
                    <select name="airline" id="airline">
                        <option value="">Any Airline</option>
                        <option value="Philippine Airlines">Philippine Airlines</option>
                        <option value="Cebu Pacific">Cebu Pacific</option>
                        <option value="Singapore Airlines">Singapore Airlines</option>
                        <option value="Emirates">Emirates</option>
                        <option value="Japan Airlines">Japan Airlines</option>
                        <option value="AirAsia">AirAsia</option>
                    </select>

                    <label class="checkbox-row" for="direct_flight">
                        <input type="checkbox" id="direct_flight" name="direct_flight" value="yes">
                        <i class="bi bi-check-circle"></i> Direct flight only
                    </label>

                    <label class="checkbox-row" for="flexible_dates">
                        <input type="checkbox" id="flexible_dates" name="flexible_dates" value="yes">
                        <i class="bi bi-check-circle"></i> Flexible dates
                    </label>

                    <!-- Dual-Thumb Price Slider -->
                    <label for="price_range"><i class="bi bi-currency-dollar"></i> Price Range</label>
                    <div class="price-slider-wrap">
                        <div class="price-slider-track" id="price-slider-track"></div>
                        <input type="range" id="price_min" name="price_min" min="0" max="3000" value="0" step="50" class="price-range-input price-range-min">
                        <input type="range" id="price_max" name="price_max" min="0" max="3000" value="3000" step="50" class="price-range-input price-range-max">
                    </div>
                    <div class="price-slider-labels">
                        <span id="price-min-label">$0</span>
                        <span id="price-max-label">$3,000</span>
                    </div>
                </div>
            </details>

            <!-- Submit Button -->
            <button type="submit" class="search-button">Search Flights</button>
        </form>
    </section>
</main>

<!-- Toast Notification Container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Search form interaction script (trip type, dates, passengers, price slider) -->
<script src="/scripts/search-script.js"></script>

<!-- Validate, then redirect to the results page (server-rendered results.hbs) -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('searchForm');

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        var origin = document.getElementById('origin').value;
        var destination = document.getElementById('destination').value;
        var date = document.getElementById('departure_date').value;
        var returnDateEl = document.getElementById('return_date');
        var returnDate = returnDateEl ? returnDateEl.value : '';
        var tripType = (document.querySelector('input[name="trip_type"]:checked') || {}).value;
        var cabinClass = document.getElementById('cabin_class') ? document.getElementById('cabin_class').value : '';
        var airline = document.getElementById('airline') ? document.getElementById('airline').value : '';
        var directFlight = document.getElementById('direct_flight') && document.getElementById('direct_flight').checked ? 'yes' : '';

        // Validate return date
        var returnDateError = document.getElementById('return-date-error');
        if (tripType === 'round_trip' && date && returnDate && new Date(returnDate) < new Date(date)) {
            if (returnDateError) returnDateError.style.display = 'block';
            return;
        }
        if (returnDateError) returnDateError.style.display = 'none';

        if (!origin && !destination && !date) {
            alert('Please enter at least one search criterion.');
            return;
        }

        // Build query string and redirect to the results page.
        // NOTE: this route must be registered server-side, e.g.
        //   router.get('/results', (req, res) => res.render('results'));
        var params = new URLSearchParams();
        if (origin) params.set('origin', origin);
        if (destination) params.set('destination', destination);
        if (date) params.set('date', date);
        if (returnDate) params.set('return_date', returnDate);
        if (cabinClass) params.set('cabin_class', cabinClass);
        if (airline) params.set('airline', airline);
        if (tripType) params.set('trip_type', tripType);
        if (directFlight) params.set('direct_flight', directFlight);

        window.location.href = '/results?' + params.toString();
    });
});
</script>
