<div class="reservations-container">
        <h2 class="reservations-title"><i class="bi bi-journal-bookmark-fill"></i> My Reservations</h2>
        <div class="row mb-4 align-items-end">
    <div class="col-md-6">
        <label class="small font-weight-bold text-muted text-uppercase" for="searchReservations">Search Reservations</label>
        <input type="text" class="form-control" id="searchReservations" placeholder="e.g. LAX or SIN">
    </div>
    <div class="col-md-4">
        <label class="small font-weight-bold text-muted text-uppercase" for="statusFilter">Filter by Status</label>
        <select class="form-control" id="statusFilter">
            <option value="all">All Statuses</option>
            <option value="confirmed">Confirmed</option>
            <option value="pending">Pending</option>
            <option value="cancelled">Cancelled</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" id="applyFilters">Filter</button>
    </div>
</div>
        <!-- Reservations Accordion -->
        <div class="accordion" id="reservationsAccordion">

            {{#if reservations.length}}
                {{#each reservations}}
                    <div class="card reservation-card"
                         data-reservation-id="{{this._id}}"
                         data-status="{{this.status}}"
                         data-route="{{this.flight.origin}} {{this.flight.destination}}">
                        <div class="p-0" id="heading-{{this._id}}">
                            <div class="d-flex justify-content-between align-items-center pr-4">
                                <button class="accordion-trigger-btn{{#unless @first}} collapsed{{/unless}}" type="button" data-toggle="collapse" data-target="#collapse-{{this._id}}" aria-expanded="{{#if @first}}true{{else}}false{{/if}}" aria-controls="collapse-{{this._id}}">
                                    <i class="bi bi-chevron-down chevron-icon-anim"></i> {{this.flight.origin}} &rarr; {{this.flight.destination}}
                                </button>
                                <span class="badge status-badge-pill {{#if this.isConfirmed}}badge-confirmed{{/if}}{{#if this.isPending}}badge-pending{{/if}}{{#if this.isCancelled}}badge-cancelled{{/if}}">{{this.status}}</span>
                            </div>
                        </div>
                        <div id="collapse-{{this._id}}" class="collapse{{#if @first}} show{{/if}}" aria-labelledby="heading-{{this._id}}" data-parent="#reservationsAccordion">
                            <div class="card-body pt-0 px-5 pb-4">
                                <div class="row">
                                    <div class="col-md-3 mb-3 mb-md-0">
                                        <h6 class="info-row-heading">Reservation #</h6>
                                        <p class="info-row-data">{{this.reservationNumber}}</p>
                                    </div>
                                    <div class="col-md-3 mb-3 mb-md-0">
                                        <h6 class="info-row-heading">Passenger</h6>
                                        <p class="info-row-data">{{#each this.passengers}}{{this.fullName}}{{#unless @last}}, {{/unless}}{{/each}}</p>
                                    </div>
                                    <div class="col-md-3 mb-3 mb-md-0">
                                        <h6 class="info-row-heading">Seat Selection</h6>
                                        <p class="info-row-data">{{this.seatDisplay}}</p>
                                    </div>
                                    <div class="col-md-3 text-md-right">
                                        <h6 class="info-row-heading">Total Price</h6>
                                        <p class="info-row-data price-display-tag">${{this.totalPrice}}</p>
                                    </div>
                                </div>
                                {{#if this.isCancelled}}
                                    <div class="alert cancelled-status-box mt-4 mb-0 d-flex align-items-center py-3 px-4" role="alert">
                                        <i class="bi bi-info-circle-fill mr-2 text-secondary" style="font-size: 1.1rem;"></i>
                                        This booking has been cancelled and cannot be modified.
                                    </div>
                                {{else}}
                                    <hr class="card-inner-divider">
                                    <div class="text-right">
                                        <button class="btn btn-action-outline btn-action-modify mr-2" data-toggle="modal" data-target="#modifyModal" data-reservation-id="{{this._id}}">
                                            <i class="bi bi-pencil-square mr-1"></i> Modify Booking
                                        </button>
                                        <button class="btn btn-action-outline btn-action-cancel" data-toggle="modal" data-target="#cancelModal" data-reservation-id="{{this._id}}">
                                            <i class="bi bi-x-circle mr-1"></i> Cancel Booking
                                        </button>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                {{/each}}
            {{else}}
                <div class="text-center text-muted py-5">
                    <i class="bi bi-journal-x" style="font-size: 2rem;"></i>
                    <p class="mt-2 mb-0">You don't have any reservations yet.</p>
                </div>
            {{/if}}

        </div>
    </div>

    <!-- Modify Reservation Modal -->
    <div class="modal fade" id="modifyModal" tabindex="-1" role="dialog" aria-labelledby="modifyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-xl);">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title font-weight-bold" id="modifyModalLabel"><i class="bi bi-pencil-square mr-2 text-primary"></i>Modify Reservation</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body px-4">
                    <form id="modifyForm">
                        <div class="form-group">
                            <label class="small font-weight-bold text-muted text-uppercase" for="newDate">New Travel Date</label>
                            <input type="date" class="form-control" id="newDate">
                        </div>
                        <div class="form-group">
                            <label class="small font-weight-bold text-muted text-uppercase" for="newSeat">Update Seat Selection</label>
                            <input type="text" class="form-control" id="newSeat" placeholder="e.g. 15A">
                        </div>
                        <p class="text-muted small mb-0">Additional charges might map based on scheduling adjustments and standard seat availability.</p>
                    </form>
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4">
                    <button type="button" class="btn btn-secondary font-weight-bold btn-sm px-3" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary btnSave font-weight-bold btn-sm px-3" data-dismiss="modal">Save Changes</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Reservation Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-xl);">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title text-danger font-weight-bold" id="cancelModalLabel"><i class="bi bi-exclamation-triangle-fill mr-2"></i>Cancel Reservation</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body px-4 text-muted">
                    Are you sure you want to cancel this booking? This processing rule is permanent and immediate adjustments may apply.
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4">
                    <button type="button" class="btn btn-secondary font-weight-bold btn-sm px-3" data-dismiss="modal">Keep Booking</button>
                    <button type="button" class="btn btn-danger btnDelete font-weight-bold btn-sm px-3" data-dismiss="modal">Confirm Cancellation</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container" id="toastContainer"></div>