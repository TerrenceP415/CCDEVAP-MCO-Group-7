<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} | SkyBook</title>
  
  <link rel="stylesheet" href="/styles.css">
  <!-- Bootstrap -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
    
  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous" defer></script>
  <!-- JS -->
  <script src="/scripts/scripts.js" defer></script>
  <script src="/scripts/data.js" defer></script>
</head>
<body>
  <header>
        <nav class="nav">
            <h1 class="logo">Sky<span class="ease">Ease</span></h1>

            <ul class="nav-links">
                <li><a href="/" class="current">Home</a></li>
                <li><a href="/search">Search Flights</a></li>
                <li><a href="booking.html">Book Flights</a></li>
                <li><a href="/my-reservations">My Reservations</a></li>
                <li><a href="#">User Profile <i class="bi bi-chevron-down"></i></a>
                    <div class="profile-dropdown">
                        <ul>
                            <li><a href="profile.html"><i class="bi bi-person"></i> Profile</a></li>
                            <li><a href="settings.html"><i class="bi bi-gear"></i> Settings</a></li>
                            <li><a href="#"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
                        </ul>
                    </div>
                </li>
                <li><a href="admin-flights.html">Admin Panel</a></li>
                <li><a class="login" href="login.html">Login</a></li>
            </ul>

            <div class="hamburger">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
        </nav>
  </header>

  {{#each error}}
    <div class="alert alert-danger mx-3 mt-2">{{ this }}</div>
  {{/each}}
  {{#each success}}
    <div class="alert alert-success mx-3 mt-2">{{ this }}</div>
  {{/each}}

  {{{ body }}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>