<main class="tabcontent" id="admin-Reservations">
    
        <h3><i class="bi bi-airplane"></i> Admin Reservations</h3>
        <p>Manage all reservations and bookings.</p>
        <button id="addUser" class="action-btn-admin" data-toggle="modal" data-target="#addUserModal"
                    style="background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%); box-shadow: 0 2px 8px rgba(2,132,199,0.25);">
                    <i class="bi bi-person-plus"></i> Add New Reservation
                </button>
        <div class="admin-table-wrapper" id="reservationsTableWrapper">
            
        <table class="admin-table table" id="reservationsTable">
                <thead>
                    <tr>
                        <th></th> <th>Reservation Number</th>
                        <th>Origin</th>
                        <th>Destination</th>
                        <th>Departure Time</th>
                        <th>Arrival Time</th>
                        <th>Seat Number</th>
                        <th>Total Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Loop through reservations and display them in the table -->
                    {{#each reservations}}
                        <tr class="details-clickable-row" id="reservationRow-{{this._id}}" data-toggle="collapse" data-target="#details-{{this._id}}"
                            aria-expanded="false" aria-controls="details-{{this._id}}" style="cursor: pointer;">
                            <td class="details-chevron"><i class="bi bi-chevron-right"></i></td>
                            <td>{{this.reservationNumber}}</td>
                            <td>{{this.flight.origin}}</td>
                            <td>{{this.flight.destination}}</td>
                            <td>{{formatDate this.flight.departureDateTime}}</td>
                            <td>{{formatDate this.flight.arrivalDateTime}}</td>
                            <td>{{this.seatDisplay}}</td>
                            <td>${{this.totalPrice}}</td>
                            <td><span class="admin-status badge badge-{{#if this.isConfirmed}}success{{else if this.isCancelled}}danger{{else}}warning{{/if}}">{{this.status}}</span></td>
                            <td>
                            <button  type="button" class="btn btn-primary action-btn-admin btn-edit-reservation" data-toggle="modal" data-target="#editReservationModal"
                                data-id="{{this._id}}"
                                data-reservation-number="{{this.reservationNumber}}"
                                data-flight-number="{{this.flight.flightNumber}}"
                                data-seat-number="{{this.seatDisplay}}"
                                data-total-price="{{this.totalPrice}}"
                                data-status="{{this.status}}"
                                data-meal-package="{{this.mealPackage}}"
                                data-extra-services="{{this.extraServices}}"
                                data-passenger-count="{{this.passengers.length}}"
                                data-passenger-names="{{#each this.passengers}}{{this.fullName}}{{#unless @last}}&#10;{{/unless}}{{/each}}"
                                data-passenger-emails="{{#each this.passengers}}{{this.email}}{{#unless @last}}&#10;{{/unless}}{{/each}}"
                                data-passenger-passports="{{#each this.passengers}}{{this.passportNumber}}{{#unless @last}}&#10;{{/unless}}{{/each}}">Edit</button>
                            <button type="button" class="btn btn-danger btn-primary action-btn-admin btn-delete-reservation" data-toggle="modal" data-target="#deleteConfirmationModal" data-id="{{this._id}}" data-reservation-number="{{this.reservationNumber}}">Delete</button>
                            </td>
                            
                        </tr>
                        <tr class="details-collapse-row">
                            <td colspan="10" class="p-0 border-top-0">
                                <!-- Match id to data-target of the parent clickable row using MongoDB _id -->
                                <div id="details-{{this._id}}" class="collapse" data-parent="#reservationsTable">
                                    <div class="p-3 bg-light border-bottom">
                                        <div class="row">
                                            <!-- Passenger Name List -->
                                            <div class="col-md-3">
                                                <strong>Passenger Names:</strong>
                                                {{#each this.passengers}}
                                                    <p class="mb-1 text-muted">{{this.fullName}} <small class="text-secondary">({{this.seatNumber}})</small></p>
                                                {{else}}
                                                    <p class="mb-1 text-muted text-italic">No passengers listed</p>
                                                {{/each}}
                                            </div>

                                            <!-- Passenger Count -->
                                            <div class="col-md-2">
                                                <strong>Passenger Count:</strong>
                                                <p class="mb-2 text-muted">
                                                    {{#if this.passengers.length}}
                                                        {{this.passengers.length}} Passenger(s)
                                                    {{else}}
                                                        0 Passengers
                                                    {{/if}}
                                                </p>
                                            </div>

                                            <!--  Meal Package -->
                                            <div class="col-md-3">
                                                <strong>Meal Package:</strong>
                                                <p class="mb-2 text-muted">
                                                    {{#if this.mealPackage}}
                                                        {{this.mealPackage}}
                                                    {{else}}
                                                        None Selected
                                                    {{/if}}
                                                </p>
                                            </div>

                                            <!-- Dynamic Extra Services -->
                                            <div class="col-md-4">
                                                <strong>Extra Services:</strong>
                                                <p class="mb-2 text-muted">
                                                    {{#if this.extraServices}}
                                                        {{this.extraServices}}
                                                    {{else}}
                                                        No Add-ons Selected
                                                    {{/if}}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                </tbody>
            </table>


            <!-- Modals -->

            <!-- Add Reservation Modal -->
        <div class="modal fade" id="addUserModal" tabindex="-1" role="dialog" aria-labelledby="addReservationModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addReservationModalTitle">Add New Reservation</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form action="/admin/reservations/create" method="POST">
                <div class="row">
                    <div class="col-md-6">
                    <div class="form-group">
                        <label for="addReservationNumber">Reservation Number</label>
                        <input name="reservationNumber" type="text" class="form-control" id="addReservationNumber" placeholder="e.g., RN789" required>
                    </div>
                    <div class="form-group">
                        <label for="addFlightNumber">Flight Number</label>
                        <input name="flightNumber" type="text" class="form-control" id="addFlightNumber" placeholder="e.g., FL-1234" required autocomplete="off">
                        <small id="addFlightLookupStatus" class="form-text"></small>
                    </div>
                    <div class="form-group">
                        <label>Flight Details</label>
                        <div class="form-control-plaintext flight-preview border rounded p-2" id="addFlightPreview">
                            <span class="text-muted">Enter a flight number to load flight details</span>
                        </div>
                    </div>
                    </div>

                    <div class="col-md-6">
                    <div class="form-group">
                        <label for="addSeatNumber">Seat Number(s)</label>
                        <input name="seatNumber" type="text" class="form-control" id="addSeatNumber" placeholder="e.g., 12A, 12B, 12C" required>
                    </div>
                    <div class="form-group">
                        <label for="addTotalPrice">Total Price</label>
                        <input name="totalPrice" type="text" class="form-control" id="addTotalPrice" placeholder="e.g., $350" required>
                    </div>
                    <div class="form-group">
                        <label for="addReservationStatus">Status</label>
                        <select name="status" class="form-control" id="addReservationStatus" required>
                        <option value="Pending" selected>Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="addPassengerCount">Passenger Count</label>
                        <input name="passengerCount" type="text" class="form-control" id="addPassengerCount" placeholder="e.g., 3 Adults, 0 Children" required>
                    </div>
                    </div>
                </div>

                <hr>

                <div class="row">
                    <div class="col-md-12">
                    <div class="form-group">
                        <label for="addPassengerNames">Passenger Names (One per line)</label>
                        <textarea name="passengerNames" class="form-control" id="addPassengerNames" rows="3" placeholder="Enter passenger names" required></textarea>
                    </div>
                    </div>
                    <div class="col-md-6">
                    <div class="form-group">
                        <label for="addPassengerEmails">Passenger Emails (One per line, matching name order)</label>
                        <textarea name="passengerEmails" class="form-control" id="addPassengerEmails" rows="3" placeholder="Enter passenger emails" required></textarea>
                    </div>
                    </div>
                    <div class="col-md-6">
                    <div class="form-group">
                        <label for="addPassengerPassports">Passport Numbers (One per line, matching name order)</label>
                        <textarea name="passengerPassports" class="form-control" id="addPassengerPassports" rows="3" placeholder="Enter passport numbers" required></textarea>
                    </div>
                    </div>
                    <div class="col-md-6">
                    <div class="form-group">
                        <label for="addMealPackage">Meal Package</label>
                        <input name="mealPackage" type="text" class="form-control" id="addMealPackage" placeholder="e.g., 2x Standard, 1x Vegetarian">
                    </div>
                    </div>
                    <div class="col-md-6">
                    <div class="form-group">
                        <label for="addExtraServices">Extra Services</label>
                        <input name="extraServices" type="text" class="form-control" id="addExtraServices" placeholder="e.g., 1x Extra Baggage, Priority Boarding">
                    </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Discard</button>
                    <button type="submit" class="btn btn-success">Add Reservation</button>
                </div>
                </form>
            </div>
            </div>
        </div>
        </div>
     
      <!-- Edit Reservation -->
       <div class="modal fade" id="editReservationModal" tabindex="-1" role="dialog" aria-labelledby="editReservationModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editReservationModalTitle">Edit Reservation</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

            <form action="/admin/reservations/update" method="POST" id="editReservationForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editReservationNumber">Reservation Number</label>
                                <input name="reservationNumber" type="text" class="form-control" id="editReservationNumber" readonly>
                            </div>
                            <div class="form-group">
                                <label for="editFlightNumber">Flight Number</label>
                                <input name="flightNumber" type="text" class="form-control" id="editFlightNumber" placeholder="e.g., FL-1234" required autocomplete="off">
                                <small id="editFlightLookupStatus" class="form-text"></small>
                            </div>
                            <div class="form-group">
                                <label>Flight Details</label>
                                <div class="form-control-plaintext flight-preview border rounded p-2" id="editFlightPreview">
                                    <span class="text-muted">Enter a flight number to load flight details</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editSeatNumber">Seat Number(s)</label>
                                <input name="seatNumber" type="text" class="form-control" id="editSeatNumber" placeholder="e.g., 12A, 12B, 12C" required>
                            </div>
                            <div class="form-group">
                                <label for="editTotalPrice">Total Price</label>
                                <input name="totalPrice" type="text" class="form-control" id="editTotalPrice" placeholder="Enter price" required>
                            </div>
                            <div class="form-group">
                                <label for="editReservationStatus">Status</label>
                                <select name="status" class="form-control" id="editReservationStatus" required>
                                    <option value="Pending">Pending</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="editPassengerCount">Passenger Count</label>
                                <input name="passengerCount" type="text" class="form-control" id="editPassengerCount" placeholder="e.g., 3 Passengers" required>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="editPassengerNames">Passenger Names (One per line)</label>
                                <textarea name="passengerNames" class="form-control" id="editPassengerNames" rows="3" placeholder="Enter passenger names" required></textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editPassengerEmails">Passenger Emails (One per line, matching name order)</label>
                                <textarea name="passengerEmails" class="form-control" id="editPassengerEmails" rows="3" placeholder="Enter passenger emails" required></textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editPassengerPassports">Passport Numbers (One per line, matching name order)</label>
                                <textarea name="passengerPassports" class="form-control" id="editPassengerPassports" rows="3" placeholder="Enter passport numbers" required></textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editMealPackage">Meal Package</label>
                                <input name="mealPackage" type="text" class="form-control" id="editMealPackage" placeholder="e.g., 2x Standard, 1x Vegetarian">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="editExtraServices">Extra Services</label>
                                <input name="extraServices" type="text" class="form-control" id="editExtraServices" placeholder="e.g., 1x Extra Baggage, Priority Boarding">
                            </div>
                        </div>
                    </div>
                </div>
            
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-success btnSave" >Save Changes</button>
                </div>
            </form>
            </div>
        </div>
    </div>

        <!-- Save Toast Notificaiton -->
            <div class="toast-container" id="toastContainer"></div>

        <!-- Delete Confirmation -->

        <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Delete Reservation</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete reservation <strong id="deleteReservationNumber"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                
                <!-- Handle Deletion -->
                <button type="button" class="btn btn-danger btnDelete" data-dismiss="modal">Delete Reservation</button>

                
            </div>
            </div>
        </div>
        </div>

        <script>
            (function () {
                // Get elements
                var deleteModal = document.getElementById('deleteConfirmationModal');
                var reservationNumberLabel = document.getElementById('deleteReservationNumber');
                var confirmDeleteBtn = deleteModal.querySelector('.btnDelete');
                var pendingDeleteId = null;

                var editModal = document.getElementById('editReservationModal');
                var editForm = document.getElementById('editReservationForm');
                var pendingEditId = null;

                // Format date
                function toDatetimeLocalValue(dateInput) {
                    if (!dateInput) return '';
                    var d = new Date(dateInput);
                    if (isNaN(d.getTime())) return '';
                    var pad = function (n) { return String(n).padStart(2, '0'); };
                    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
                        'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
                }
                
                function escapeHtml(str) {
                    var div = document.createElement('div');
                    div.textContent = str == null ? '' : String(str);
                    return div.innerHTML;
                }

                // format display
                function formatDateDisplay(dateInput) {
                    if (!dateInput) return '';
                    var d = new Date(dateInput);
                    if (isNaN(d.getTime())) return '';
                    
                    // Formats date to: "MMM D, YYYY h:mm A" with the user's localized time zone output
                    var dateString = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    var timeString = d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
                    return dateString + ' ' + timeString;
                }

                // Looks up a flight by number as the admin types it, and renders a read-only
                // preview (origin, destination, times, seats) so the reservation always
                
                function setupFlightLookup(inputId, previewId, statusId) {
                    //get field elements
                    var input = document.getElementById(inputId);
                    var preview = document.getElementById(previewId);
                    var statusEl = document.getElementById(statusId);
                    var lookupTimer = null;
                    var currentFlight = null;
                    //placeholder and display flight details when flight number is found
                    function renderPreview(flight) {
                        if (!flight) {
                            preview.innerHTML = '<span class="text-muted">Enter a flight number to load flight details</span>';
                            return;
                        }
                        preview.innerHTML =
                            '<div>' + escapeHtml(flight.origin) + ' &rarr; ' + escapeHtml(flight.destination) + '</div>' +
                            '<div class="text-muted small">Departs: ' + formatDateDisplay(flight.departureDateTime) + '</div>' +
                            '<div class="text-muted small">Arrives: ' + formatDateDisplay(flight.arrivalDateTime) + '</div>' +
                            '<div class="text-muted small">Available seats: ' + flight.availableSeats + ' / ' + flight.totalSeats + '</div>';
                    }
                    //search flight
                    function doLookup() {
                        var value = input.value.trim();
                        currentFlight = null;

                        if (!value) {
                            renderPreview(null);
                            statusEl.textContent = '';
                            return;
                        }

                        statusEl.textContent = 'Looking up flight...';
                        statusEl.className = 'form-text text-muted';

                        fetch('/admin/reservations/flight-lookup/' + encodeURIComponent(value))
                            .then(function (response) {
                                return response.json().then(function (data) { return { ok: response.ok, data: data }; });
                            })
                            .then(function (result) {
                                if (!result.ok || !result.data.success) {
                                    renderPreview(null);
                                    statusEl.textContent = result.data.message || 'Flight not found';
                                    statusEl.className = 'form-text text-danger';
                                    return;
                                }
                                currentFlight = result.data.flight;
                                renderPreview(currentFlight);
                                statusEl.textContent = 'Flight found';
                                statusEl.className = 'form-text text-success';
                            })
                            .catch(function () {
                                renderPreview(null);
                                statusEl.textContent = 'Error looking up flight';
                                statusEl.className = 'form-text text-danger';
                            });
                    }
                    
                    input.addEventListener('input', function () {
                        clearTimeout(lookupTimer);
                        lookupTimer = setTimeout(doLookup, 400);
                    });

                    return {
                        refresh: doLookup,
                        setValue: function (value) {
                            input.value = value || '';
                            doLookup();
                        }
                    };
                }
                //do for both add and edit
                window.addFlightLookup = setupFlightLookup('addFlightNumber', 'addFlightPreview', 'addFlightLookupStatus');
                window.editFlightLookup = setupFlightLookup('editFlightNumber', 'editFlightPreview', 'editFlightLookupStatus');

                // use flight and reservation numbers to get flight and reservation data.
                document.addEventListener('click', function (e) {
                    var btn = e.target.closest('.btn-edit-reservation');
                    if (!btn) return;

                    pendingEditId = btn.getAttribute('data-id');
        
                    document.getElementById('editReservationNumber').value = btn.getAttribute('data-reservation-number') || '';
                    if (window.editFlightLookup) {
                        window.editFlightLookup.setValue(btn.getAttribute('data-flight-number') || '');
                    } else {
                        document.getElementById('editFlightNumber').value = btn.getAttribute('data-flight-number') || '';
                    }
                    //load in previous data
                    document.getElementById('editSeatNumber').value = btn.getAttribute('data-seat-number') || '';
                    document.getElementById('editTotalPrice').value = btn.getAttribute('data-total-price') || '';
                    document.getElementById('editReservationStatus').value = btn.getAttribute('data-status') || 'Pending';
                    document.getElementById('editPassengerCount').value = (btn.getAttribute('data-passenger-count') || '0') + ' Passenger(s)';
                    document.getElementById('editPassengerNames').value = btn.getAttribute('data-passenger-names') || '';
                    document.getElementById('editPassengerEmails').value = btn.getAttribute('data-passenger-emails') || '';
                    document.getElementById('editPassengerPassports').value = btn.getAttribute('data-passenger-passports') || '';
                    document.getElementById('editMealPackage').value = btn.getAttribute('data-meal-package') || '';
                    document.getElementById('editExtraServices').value = btn.getAttribute('data-extra-services') || '';
                });

                //accordion for reservation
                function buildDetailsHTML(reservation) {
                    var passengersHtml = '<p class="mb-1 text-muted text-italic">No passengers listed</p>';
                    if (reservation.passengers && reservation.passengers.length > 0) {
                        passengersHtml = reservation.passengers.map(function (p) {
                            return '<p class="mb-1 text-muted">' + escapeHtml(p.fullName) +
                                ' <small class="text-secondary">(' + escapeHtml(p.seatNumber) + ')</small></p>';
                        }).join('');
                    }

                    var passengerCountText = (reservation.passengers && reservation.passengers.length > 0)
                        ? reservation.passengers.length + ' Passenger(s)'
                        : '0 Passengers';

                    var mealText = reservation.mealPackage ? escapeHtml(reservation.mealPackage) : 'None Selected';
                    var extrasText = reservation.extraServices ? escapeHtml(reservation.extraServices) : 'No Add-ons Selected';

                    return '<div class="p-3 bg-light border-bottom"><div class="row">' +
                        '<div class="col-md-3"><strong>Passenger Names:</strong>' + passengersHtml + '</div>' +
                        '<div class="col-md-2"><strong>Passenger Count:</strong><p class="mb-2 text-muted">' + passengerCountText + '</p></div>' +
                        '<div class="col-md-3"><strong>Meal Package:</strong><p class="mb-2 text-muted">' + mealText + '</p></div>' +
                        '<div class="col-md-4"><strong>Extra Services:</strong><p class="mb-2 text-muted">' + extrasText + '</p></div>' +
                        '</div></div>';
                }

                // update row
                function updateReservationRowDOM(reservation) {
                    var row = document.getElementById('reservationRow-' + reservation._id);
                    if (!row) return;

                    var statusClass = reservation.isConfirmed ? 'success' : (reservation.isCancelled ? 'danger' : 'warning');
                    var cells = row.querySelectorAll('td');

                    cells[1].textContent = reservation.reservationNumber;
                    cells[2].textContent = reservation.flight ? reservation.flight.origin : '';
                    cells[3].textContent = reservation.flight ? reservation.flight.destination : '';
                    cells[4].textContent = reservation.flight ? formatDateDisplay(reservation.flight.departureDateTime) : '';
                    cells[5].textContent = reservation.flight ? formatDateDisplay(reservation.flight.arrivalDateTime) : '';
                    cells[6].textContent = reservation.seatDisplay;
                    cells[7].textContent = '$' + reservation.totalPrice;

                    var statusBadge = row.querySelector('.admin-status');
                    if (statusBadge) {
                        statusBadge.textContent = reservation.status;
                        statusBadge.className = 'admin-status badge badge-' + statusClass;
                    }

                    var passengerNames = (reservation.passengers || []).map(function (p) { return p.fullName; }).join('\n');
                    var passengerEmails = (reservation.passengers || []).map(function (p) { return p.email; }).join('\n');
                    var passengerPassports = (reservation.passengers || []).map(function (p) { return p.passportNumber; }).join('\n');

                    var editBtn = row.querySelector('.btn-edit-reservation');
                    if (editBtn) {
                        editBtn.setAttribute('data-reservation-number', reservation.reservationNumber);
                        editBtn.setAttribute('data-flight-number', reservation.flight ? reservation.flight.flightNumber : '');
                        editBtn.setAttribute('data-seat-number', reservation.seatDisplay);
                        editBtn.setAttribute('data-total-price', reservation.totalPrice);
                        editBtn.setAttribute('data-status', reservation.status);
                        editBtn.setAttribute('data-meal-package', reservation.mealPackage || '');
                        editBtn.setAttribute('data-extra-services', reservation.extraServices || '');
                        editBtn.setAttribute('data-passenger-count', (reservation.passengers || []).length);
                        editBtn.setAttribute('data-passenger-names', passengerNames);
                        editBtn.setAttribute('data-passenger-emails', passengerEmails);
                        editBtn.setAttribute('data-passenger-passports', passengerPassports);
                    }

                    var deleteBtn = row.querySelector('.btn-delete-reservation');
                    if (deleteBtn) {
                        deleteBtn.setAttribute('data-reservation-number', reservation.reservationNumber);
                    }

                    var detailsDiv = document.getElementById('details-' + reservation._id);
                    if (detailsDiv) {
                        detailsDiv.innerHTML = buildDetailsHTML(reservation);
                    }
                }

                // submit; uses Ajax for no refresh change
                editForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (!pendingEditId) return;

                    var formData = new FormData(editForm);
                    var payload = {};
                    formData.forEach(function (value, key) { payload[key] = value; });

                    fetch('/admin/reservations/update/' + pendingEditId, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                        .then(function (response) {
                            return response.json().then(function (data) {
                                return { ok: response.ok, data: data };
                            });
                        })
                        .then(function (result) {
                            if (!result.ok || !result.data.success) {
                                throw new Error(result.data.message || 'Failed to update reservation');
                            }

                            updateReservationRowDOM(result.data.reservation);
                            showToast('Reservation updated successfully', 'success');

                            // Perform proper cleanup and hide modal
                            if (window.jQuery && jQuery.fn.modal) {
                                jQuery('#editReservationModal').modal('hide');
                            } else {
                                editModal.classList.remove('show');
                                editModal.style.display = 'none';
                                document.body.classList.remove('modal-open');
                                var backdrop = document.querySelector('.modal-backdrop');
                                if (backdrop) backdrop.remove();
                            }
                        })
                        .catch(function (err) {
                            console.error(err);
                            showToast('Error updating reservation', 'danger');
                        })
                        .finally(function () {
                            pendingEditId = null;
                        });
                });

                // get delete button and ID to delete
                document.addEventListener('click', function (e) {
                    var btn = e.target.closest('.btn-delete-reservation');
                    if (!btn) return;
                    pendingDeleteId = btn.getAttribute('data-id');
                    reservationNumberLabel.textContent = btn.getAttribute('data-reservation-number') || '';
                });

                // Handle Deletion
                confirmDeleteBtn.addEventListener('click', function () {
                    if (!pendingDeleteId) return;
                    var idToDelete = pendingDeleteId;

                    fetch('/admin/reservations/delete/' + idToDelete, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    })
                        .then(function (response) {
                            return response.json().then(function (data) {
                                return { ok: response.ok, data: data };
                            });
                        })
                        .then(function (result) {
                            if (!result.ok || !result.data.success) {
                                throw new Error(result.data.message || 'Failed to delete reservation');
                            }

                            var row = document.getElementById('reservationRow-' + idToDelete);
                            var detailsRow = document.getElementById('details-' + idToDelete);
                            if (row) {
                                var detailsWrapperRow = detailsRow ? detailsRow.closest('tr') : null;
                                row.remove();
                                if (detailsWrapperRow) detailsWrapperRow.remove();
                            }

                            showToast('Reservation deleted successfully', 'success');
                        })
                        .catch(function (err) {
                            console.error(err);
                            showToast('Error deleting reservation', 'danger');
                        })
                        .finally(function () {
                            pendingDeleteId = null;
                        });
                });
        
                function showToast(message, variant) {
                    var container = document.getElementById('toastContainer');
                    if (!container) return;

                    var toast = document.createElement('div');
                    toast.className = 'toast align-items-center text-white bg-' + variant + ' border-0';
                    toast.setAttribute('role', 'alert');
                    toast.innerHTML =
                        '<div class="d-flex">' +
                        '<div class="toast-body">' + message + '</div>' +
                        '<button type="button" class="close mr-2 m-auto text-white" data-dismiss="toast">&times;</button>' +
                        '</div>';

                    container.appendChild(toast);

                    if (window.jQuery && jQuery.fn.toast) {
                        jQuery(toast).toast({ delay: 3000 }).toast('show');
                        jQuery(toast).on('hidden.bs.toast', function () { toast.remove(); });
                    } else {
                        toast.style.display = 'block';
                        setTimeout(function () { toast.remove(); }, 3000);
                    }
                }
            })();
        </script>
