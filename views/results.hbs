<!-- Search Results -->
<div class="results-header">
    <h3><i class="bi bi-search"></i> Search Results</h3>
    <p id="resultsSubtitle">Showing available flights based on your search criteria.</p>
</div>

<div class="results-shell">
<div class="results-layout">

    <!-- Filter Sidebar -->
    <aside class="filter-sidebar">
        <h5><i class="bi bi-airplane"></i> Airlines</h5>
        <div id="airline-checkboxes"></div>

        <hr class="sidebar-divider">

        <h5><i class="bi bi-currency-dollar"></i> Price Range</h5>
        <div class="price-inputs">
            <input type="number" id="price-min" placeholder="Min" min="0">
            <input type="number" id="price-max" placeholder="Max" min="0">
        </div>

        <hr class="sidebar-divider">

        <h5><i class="bi bi-bezier2"></i> Max Stops</h5>
        <select id="sidebar-stops">
            <option value="">Any</option>
            <option value="0">Direct only</option>
            <option value="1">Up to 1 stop</option>
            <option value="2">Up to 2 stops</option>
        </select>

        <hr class="sidebar-divider">

        <h5><i class="bi bi-clock"></i> Departure</h5>
        <select id="sidebar-depart-time">
            <option value="">Any time</option>
            <option value="morning">Morning (00:00&ndash;11:59)</option>
            <option value="afternoon">Afternoon (12:00&ndash;17:59)</option>
            <option value="evening">Evening (18:00&ndash;23:59)</option>
        </select>

        <button class="sidebar-clear-btn" id="clear-filters"><i class="bi bi-x-circle"></i> Clear All Filters</button>
    </aside>

    <!-- Main Results Content -->
    <div class="results-main">

        <!-- Top bar with search input, sort, and count -->
        <div class="results-topbar">
            <div class="topbar-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="topbar-airline" placeholder="Filter by airline name">
            </div>

            <div class="sort-wrap">
                <i class="bi bi-sort-down"></i>
                <select id="sort">
                    <option value="">Sort By</option>
                    <option value="price_asc">Price: Low &rarr; High</option>
                    <option value="price_desc">Price: High &rarr; Low</option>
                    <option value="depart_asc">Departure: Earliest</option>
                    <option value="duration_asc">Duration: Shortest</option>
                </select>
            </div>

            <span class="results-count" id="results-count">0 flights</span>
        </div>

        <!-- Flights table -->
        <div class="results-grid">
            <table class="results-table">
                <thead>
                    <tr>
                        <th>Airline</th>
                        <th>Flight</th>
                        <th>Route</th>
                        <th>Times</th>
                        <th>Duration</th>
                        <th>Stops</th>
                        <th>Class</th>
                        <th>Price</th>
                        <th>Seats</th>
                        <th>Details</th>
                        <th>Book</th>
                    </tr>
                </thead>
                <tbody id="results-body"></tbody>
            </table>
        </div>

        <!-- Shown while the AJAX request is in flight -->
        <div id="results-loading" class="no-results" style="display:none;">
            <i class="bi bi-arrow-repeat spin"></i>
            <p>Searching flights&hellip;</p>
        </div>

        <!-- Shown when no flights match -->
        <div id="no-results" class="no-results" style="display:none;">
            <i class="bi bi-airplane-engines"></i>
            <strong>No flights match your filters.</strong>
            <p>Try adjusting your search criteria or clearing filters.</p>
        </div>
    </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // ─── URL search params (passed from search.hbs) ─────────
    var urlParams = new URLSearchParams(window.location.search);
    var searchOrigin = urlParams.get('origin') || '';
    var searchDestination = urlParams.get('destination') || '';
    var searchDate = urlParams.get('date') || '';
    var searchCabinClass = urlParams.get('cabin_class') || '';
    var searchTripType = urlParams.get('trip_type') || '';
    var searchAirline = urlParams.get('airline') || '';
    var searchDirectOnly = urlParams.get('direct_flight') === 'yes';

    var classMap = {
        economy: 'Economy',
        premium_economy: 'Premium Economy',
        business: 'Business',
        first_class: 'First Class'
    };

    // ─── Banner text describing what was searched for ───────
    (function showSearchBanner() {
        var header = document.getElementById('resultsSubtitle');
        if (!header) return;

        var parts = [];
        if (searchOrigin) parts.push('From: <strong>' + searchOrigin + '</strong>');
        if (searchDestination) parts.push('To: <strong>' + searchDestination + '</strong>');
        if (searchDate) parts.push('Date: <strong>' + searchDate + '</strong>');
        if (searchCabinClass && classMap[searchCabinClass]) parts.push('Class: <strong>' + classMap[searchCabinClass] + '</strong>');
        if (searchTripType) parts.push('Trip: <strong>' + searchTripType.replace('_', ' ') + '</strong>');
        if (searchAirline) parts.push('Airline: <strong>' + searchAirline + '</strong>');
        if (searchDirectOnly) parts.push('<strong>Direct only</strong>');

        header.innerHTML = parts.length > 0 ? parts.join(' &nbsp;|&nbsp; ') : 'Showing all available flights.';
    })();

    var tbody = document.getElementById('results-body');
    var noResults = document.getElementById('no-results');
    var loading = document.getElementById('results-loading');
    var resultsCount = document.getElementById('results-count');

    var baseFlights = [];       // raw data from the server
    var selectedAirlines = new Set();

    // ─── Helpers ──────────────────────────────────────────
    function parseDuration(str) {
        if (!str) return 0;
        var hMatch = str.match(/(\d+)h/);
        var mMatch = str.match(/(\d+)m/);
        return (hMatch ? parseInt(hMatch[1]) * 60 : 0) + (mMatch ? parseInt(mMatch[1]) : 0);
    }

    function timeBucket(dateStr) {
        if (!dateStr) return '';
        var h = new Date(dateStr).getHours();
        if (h < 12) return 'morning';
        if (h < 18) return 'afternoon';
        return 'evening';
    }

    function formatTime(dateStr) {
        if (!dateStr) return '';
        return new Date(dateStr).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    }

    function airlineLogoHtml(f) {
        if (f.airlineLogo) {
            return '<img src="/airline/' + f.airlineLogo + '" alt="' + f.airline + '" onerror="this.style.display=\'none\'">';
        }
        return '<i class="bi bi-airplane" style="font-size:24px;color:#0ea5e9;"></i>';
    }

    function seatsBadgeHtml(n) {
        if (n === 0) return '<span class="seats-badge seats-none">Sold Out</span>';
        if (n <= 5) return '<span class="seats-badge seats-few">' + n + ' left</span>';
        return '<span class="seats-badge seats-many">' + n + '</span>';
    }

    // ─── Render the table rows ────────────────────────────
    function renderFlights(flights) {
        resultsCount.textContent = flights.length + ' flight' + (flights.length !== 1 ? 's' : '');

        if (flights.length === 0) {
            tbody.innerHTML = '';
            noResults.style.display = 'block';
            return;
        }
        noResults.style.display = 'none';

        tbody.innerHTML = flights.map(function (f) {
            var toggleId = 'toggle-' + f._id;
            var soldOut = f.availableSeats <= 0;
            var bookAttrs = soldOut ? 'disabled style="opacity:.5;cursor:not-allowed;"' : '';
            var bookHref = soldOut ? '#' : '/flights/' + f._id + '/book';

            return (
                '<tr class="flight-row">' +
                    '<td>' + airlineLogoHtml(f) + '</td>' +
                    '<td style="font-weight:700;color:#0f172a;">' + f.flightNumber + '</td>' +
                    '<td style="font-weight:600;">' + f.origin + ' &rarr; ' + f.destination + '</td>' +
                    '<td>' + formatTime(f.departureDateTime) + '<br><small style="color:#64748b;">' + formatTime(f.arrivalDateTime) + '</small></td>' +
                    '<td>' + (f.duration || '') + '</td>' +
                    '<td>' + (!f.layovers ? '<span style="color:#16a34a;font-weight:700;">Direct</span>' : f.layovers + ' stop' + (f.layovers > 1 ? 's' : '')) + '</td>' +
                    '<td><span class="class-badge">' + (f.cabinClass || 'Economy') + '</span></td>' +
                    '<td style="font-weight:700;font-size:15px;">$' + f.ticketPrice.toFixed(2) + '</td>' +
                    '<td>' + seatsBadgeHtml(f.availableSeats) + '</td>' +
                    '<td><a href="/flights/' + f._id + '" class="view-details-btn">Details</a></td>' +
                    '<td><a href="' + bookHref + '" class="book-btn" ' + bookAttrs + '>' + (soldOut ? 'Sold Out' : 'Book Now') + '</a></td>' +
                '</tr>' +
                '<tr class="details-row" id="' + toggleId + '-row" style="display:none;">' +
                    '<td colspan="11">' +
                        '<div class="extra-details-container">' +
                            '<div><strong>Airline:</strong> ' + f.airline + '</div>' +
                            '<div><strong>Flight #:</strong> ' + f.flightNumber + '</div>' +
                            '<div><strong>Route:</strong> ' + f.origin + ' &rarr; ' + f.destination + '</div>' +
                            '<div><strong>Layovers:</strong> ' + (f.layovers || 0) + '</div>' +
                            '<div><strong>Seats Left:</strong> ' + f.availableSeats + '</div>' +
                            '<div><strong>Class:</strong> ' + (f.cabinClass || 'Economy') + '</div>' +
                        '</div>' +
                    '</td>' +
                '</tr>'
            );
        }).join('');
    }

    // ─── Sidebar airline checkboxes ───────────────────────
    function buildAirlineCheckboxes() {
        var airlines = Array.from(new Set(baseFlights.map(function (f) { return f.airline; })));
        var container = document.getElementById('airline-checkboxes');

        container.innerHTML = airlines.map(function (name) {
            return '<label><input type="checkbox" class="airline-cb" value="' + name + '"> ' + name + '</label>';
        }).join('');

        container.querySelectorAll('.airline-cb').forEach(function (cb) {
            cb.addEventListener('change', function () {
                if (cb.checked) selectedAirlines.add(cb.value);
                else selectedAirlines.delete(cb.value);
                applyFiltersAndSort();
            });
        });
    }

    // ─── Filter / sort ─────────────────────────────────────
    function applyFiltersAndSort() {
        var topbarAirline = (document.getElementById('topbar-airline').value || '').trim().toLowerCase();
        var sortVal = document.getElementById('sort').value;
        var priceMin = parseFloat(document.getElementById('price-min').value) || 0;
        var priceMax = parseFloat(document.getElementById('price-max').value) || Infinity;
        var maxStops = document.getElementById('sidebar-stops').value;
        var departTime = document.getElementById('sidebar-depart-time').value;

        var result = baseFlights.filter(function (f) {
            if (topbarAirline && f.airline.toLowerCase().indexOf(topbarAirline) === -1) return false;
            if (selectedAirlines.size > 0 && !selectedAirlines.has(f.airline)) return false;
            if (f.ticketPrice < priceMin || f.ticketPrice > priceMax) return false;
            if (maxStops !== '' && (f.layovers || 0) > parseInt(maxStops)) return false;
            if (departTime && timeBucket(f.departureDateTime) !== departTime) return false;
            return true;
        });

        if (sortVal === 'price_asc') result.sort(function (a, b) { return a.ticketPrice - b.ticketPrice; });
        if (sortVal === 'price_desc') result.sort(function (a, b) { return b.ticketPrice - a.ticketPrice; });
        if (sortVal === 'depart_asc') result.sort(function (a, b) { return new Date(a.departureDateTime) - new Date(b.departureDateTime); });
        if (sortVal === 'duration_asc') result.sort(function (a, b) { return parseDuration(a.duration) - parseDuration(b.duration); });

        renderFlights(result);
    }

    // ─── Fetch flights from the live API ──────────────────
    function runSearch() {
        loading.style.display = 'block';
        noResults.style.display = 'none';
        tbody.innerHTML = '';

        fetch('/api/flights/search?' + urlParams.toString())
            .then(function (response) { return response.json(); })
            .then(function (data) {
                loading.style.display = 'none';
                baseFlights = (data.success && data.flights) ? data.flights : [];
                buildAirlineCheckboxes();
                applyFiltersAndSort();
            })
            .catch(function (err) {
                loading.style.display = 'none';
                noResults.style.display = 'block';
                console.error('Search error:', err);
            });
    }

    // ─── Wire up controls ──────────────────────────────────
    ['topbar-airline', 'sort', 'price-min', 'price-max', 'sidebar-stops', 'sidebar-depart-time'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('input', applyFiltersAndSort);
    });
    ['sort', 'sidebar-stops', 'sidebar-depart-time'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('change', applyFiltersAndSort);
    });

    var clearBtn = document.getElementById('clear-filters');
    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            document.getElementById('topbar-airline').value = '';
            document.getElementById('sort').value = '';
            document.getElementById('price-min').value = '';
            document.getElementById('price-max').value = '';
            document.getElementById('sidebar-stops').value = '';
            document.getElementById('sidebar-depart-time').value = '';
            selectedAirlines.clear();
            document.querySelectorAll('.airline-cb').forEach(function (cb) { cb.checked = false; });
            applyFiltersAndSort();
        });
    }

    runSearch();
});
</script>
