
    <body class="admin-page">

        <main class="tabcontent" id="admin-Users">
            <h3><i class="bi bi-people"></i> Admin Users</h3>
            <p>Manage all user accounts and their permissions.</p>

            <div class="admin-table-wrapper" id="usersTableWrapper">

                <button id="addUser" class="action-btn-admin" data-toggle="modal" data-target="#addUserModal"
                    style="background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%); box-shadow: 0 2px 8px rgba(2,132,199,0.25);">
                    <i class="bi bi-person-plus"></i> Add New User
                </button>

                <div id="filter-users-dropdown-wrapper" class="dropdown d-inline-block">
                    <button id="filter-users-btn" class="action-btn-admin dropdown-toggle" type="button"
                        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                        style="background: linear-gradient(135deg, #334155 0%, #64748b 100%); box-shadow: 0 2px 8px rgba(51,65,85,0.2);">
                        <i class="bi bi-funnel"></i> Filter Users
                    </button>
                    <div id="filter-users-dropdown" class="dropdown-menu shadow" aria-labelledby="filter-users-btn">
                        <h6 class="filter-header">Filter by Status</h6>
                        <a class="dropdown-item user-filter" href="#" data-status="all">All Users</a>
                        <a class="dropdown-item user-filter" href="#" data-status="active">Active</a>
                        <a class="dropdown-item user-filter" href="#" data-status="suspended">Suspended</a>
                        <div class="dropdown-divider"></div>
                        <h6 class="filter-header">Filter by Role</h6>
                        <a class="dropdown-item user-filter" href="#" data-role="passenger">Passenger</a>
                        <a class="dropdown-item user-filter" href="#" data-role="admin">Admin</a>
                    </div>
                </div>

                <table class="admin-table table" id="usersTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each users}}
                        <tr data-user-id="{{this.id}}">
                            <td>{{this.name}}</td>
                            <td>{{this.email}}</td>
                            <td>{{this.role}}</td>
                            <td>
                                <span class="badge admin-status 
                                    {{#if (eq this.status 'Active')}}badge-success{{/if}}
                                    {{#if (eq this.status 'Restricted')}}badge-warning{{/if}}
                                    {{#if (eq this.status 'Banned')}}badge-danger{{/if}}">
                                    {{this.status}}
                                </span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-primary action-btn-admin edit-user-btn" 
                                    data-id="{{this.id}}" 
                                    data-name="{{this.name}}" 
                                    data-email="{{this.email}}" 
                                    data-role="{{this.role}}" 
                                    data-status="{{this.status}}" 
                                    data-toggle="modal" data-target="#editUserModal">Edit</button>
                                <button type="button" class="btn btn-danger action-btn-admin delete-user-btn" 
                                    data-id="{{this.id}}" 
                                    data-toggle="modal" data-target="#deleteUserModal">Delete</button>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>

                <!-- Add New User -->
                <div class="modal fade" id="addUserModal" tabindex="-1" role="dialog" aria-labelledby="addUserModalTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="addUserModalTitle">
                                    <i class="bi bi-person-plus mr-2"></i> Add New User
                                </h5>
                                <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="modal-body">
                                <form id="addUserForm">
                                    <div class="form-group">
                                        <label for="addName">Full Name</label>
                                        <input type="text" class="form-control" id="addName" placeholder="Enter full name" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="addEmail">Email Address</label>
                                        <input type="email" class="form-control" id="addEmail" placeholder="Enter email address" required>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="addRole">Role</label>
                                                <select class="form-control" id="addRole">
                                                    <option value="passenger">Passenger</option>
                                                    <option value="admin">Admin</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="addStatus">Status</label>
                                                <select class="form-control" id="addStatus">
                                                    <option value="active">Active</option>
                                                    <option value="restricted">Restricted</option>
                                                    <option value="banned">Banned</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="addPassword">Temporary Password</label>
                                        <input type="password" class="form-control" id="addPassword" placeholder="Set a temporary password" required>
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Discard</button>
                                <button type="button" class="btn btn-success btnCreate">Create User</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Edit User -->
                <div class="modal fade" id="editUserModal" tabindex="-1" role="dialog" aria-labelledby="editUserModalTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="editUserModalTitle">Edit User</h5>
                                <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="modal-body">
                                <form id="editUserForm">
                                    <div class="form-group">
                                        <label for="editUserId">User ID</label>
                                        <input type="text" class="form-control" id="editUserId" readonly placeholder="Auto-populated">
                                    </div>
                                    <div class="form-group">
                                        <label for="editName">Full Name</label>
                                        <input type="text" class="form-control" id="editName" placeholder="Enter full name">
                                    </div>
                                    <div class="form-group">
                                        <label for="editEmail">Email Address</label>
                                        <input type="email" class="form-control" id="editEmail" placeholder="Enter email address">
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="editRole">Role</label>
                                                <select class="form-control" id="editRole">
                                                    <option value="Passenger">Passenger</option>
                                                    <option value="Admin">Admin</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="editStatus">Status</label>
                                                <select class="form-control" id="editStatus">
                                                    <option value="Active">Active</option>
                                                    <option value="Restricted">Restricted</option>
                                                    <option value="Banned">Banned</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="editPasswordReset">Reset Password <small class="text-muted font-weight-normal">(leave blank to keep current)</small></label>
                                        <input type="password" class="form-control" id="editPasswordReset" placeholder="Enter new password">
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Discard</button>
                                <button type="button" class="btn btn-success btnSave">Save Changes</button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- MODAL: Delete User Confirmation -->
                <div class="modal fade" id="deleteUserModal" tabindex="-1" role="dialog" aria-labelledby="deleteUserModalTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteUserModalTitle">
                                    <i class="bi bi-exclamation-triangle mr-2"></i> Delete User
                                </h5>
                                <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-1">Are you sure you want to delete this user?</p>
                                <p class="text-muted mb-0" style="font-size: 13px;">This action is permanent and cannot be undone. All associated data will be removed.</p>
                                <input type="hidden" id="deleteUserId">
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-danger btnDelete">Delete User</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Centralized Toast Notification Container -->
                <div class="toast-container" id="toastContainer"></div>

            </div>
        </main>
        <script>

            document.addEventListener('DOMContentLoaded', () => {
            // Select the "Create User" button via its unique class from your HTML
            const createBtn = document.querySelector('#addUserModal .btnCreate');

            if (createBtn) {
                createBtn.addEventListener('click', async () => {
                    // Target the input fields using the exact IDs inside your modal form
                    const name = document.getElementById('addName').value;
                    const email = document.getElementById('addEmail').value;
                    const password = document.getElementById('addPassword').value;

                    // Simple validation check before submitting
                    if (!name || !email || !password) {
                        alert('Please fill out all required fields.');
                        return;
                    }

                    try {
                        // Submit payload to the prefixed admin API route
                        const response = await fetch('/admin/api/users', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ name, email, password })
                        });

                        const result = await response.json();

                        if (result.success) {
                            // Force the window to reload and grab the updated mongoose dataset
                            window.location.reload();
                        } else {
                            alert('Error creating user: ' + result.message);
                        }
                    } catch (err) {
                        console.error('Network execution failure:', err);
                        alert('An unexpected server communication error occurred.');
                    }
                });
            }
        });

        </script>
    </body>
</html>