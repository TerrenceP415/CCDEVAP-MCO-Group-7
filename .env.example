# ─── SkyEase Environment Configuration ─────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server port (default: 3000)
PORT=3000

# MongoDB connection string
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/skyEase
# Production (MongoDB Atlas example):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skyEase?retryWrites=true&w=majority

# Session secret (use a strong random string in production)
SESSION_SECRET=ccdevap_skybook_secret

# Environment: 'development' or 'production'
NODE_ENV=development
